@@ -0,0 +1,170 @@
+import { TestBed } from '@angular/core/testing';
+import { signal } from '@angular/core';
+import { AuthService } from '../core/services/auth.service';
+import { hotelTransport } from './hotel-transport';
+import { RoomCatalog, rooms, roomRates } from './room-catalog';
+
+const room = {
+  __typename: 'Room',
+  id: 'room_1',
+  num_beds: 2,
+  allow_smoking: false,
+  daily_rate: 140,
+  cleaning_fee: 20,
+};
+const response = (rate = 140) => ({
+  data: {
+    getAllRooms: {
+      __typename: 'RoomResult',
+      success: true,
+      errors: null,
+      rooms: [{ ...room, daily_rate: rate }],
+    },
+  },
+});
+
+describe('Hotel Tandrove integration', () => {
+  const token = signal<string | null>('trial-token');
+  let send: jasmine.Spy;
+  beforeEach(() => {
+    token.set('trial-token');
+    send = spyOn(window, 'fetch').and.callFake(
+      async () => new Response(JSON.stringify(response())),
+    );
+    TestBed.configureTestingModule({
+      providers: [
+        RoomCatalog,
+        { provide: AuthService, useValue: { sessionToken: token } },
+      ],
+    });
+  });
+  afterEach(() => TestBed.resetTestingModule());
+
+  it('adds business status without widening the requested room fields or changing the address', async () => {
+    const full = rooms.bind({}, { source: 'hotel-api', scope: 'test' });
+    const narrow = roomRates.bind({}, { source: 'hotel-api', scope: 'test' });
+    expect(full.stateAddress).toBe(narrow.stateAddress);
+    await hotelTransport(
+      'http://localhost/graphql',
+      'captured-token',
+    )(full.prepare('daily_rate'));
+    const request = send.calls.mostRecent().args[0] as Request;
+    const body = await request.json();
+    expect(request.headers.get('authorization')).toBe('Bearer captured-token');
+    expect(body.query).toContain('success');
+    expect(body.query).toContain('errors');
+    expect(body.query).toContain('daily_rate');
+    expect(body.query).not.toContain('cleaning_fee');
+    expect(body.query).not.toContain('num_beds');
+  });
+
+  it('rejects business failure, preserves both consumers, then refreshes only rates', async () => {
+    const catalog = TestBed.inject(RoomCatalog);
+    const full = catalog.client.watch(rooms.bind({}, catalog.binding()));
+    const preview = catalog.client.watch(roomRates.bind({}, catalog.binding()));
+    await Promise.all([full.ensure(), preview.ensure()]);
+    expect(send.calls.count()).toBe(1);
+    send.and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: false,
+                errors: ['Catalog unavailable'],
+                rooms: null,
+              },
+            },
+          }),
+        ),
+    );
+    await expectAsync(full.invalidate('daily_rate')).toBeRejectedWithError(
+      'Catalog unavailable',
+    );
+    expect(send.calls.count()).toBe(2); // Business errors are not retried.
+    expect(full.getSnapshot().records?.[0]?.data.daily_rate).toBe(140);
+    expect(preview.getSnapshot().records?.[0]?.data.daily_rate).toBe(140);
+    send.and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: true,
+                errors: null,
+                rooms: [{ ...room, daily_rate: 155, num_beds: 99 }],
+              },
+            },
+          }),
+        ),
+    );
+    await full.invalidate('daily_rate');
+    expect(preview.getSnapshot().records?.[0]?.data.daily_rate).toBe(155);
+    expect(full.getSnapshot().records?.[0]?.data.num_beds).toBe(2);
+    preview.dispose();
+    await full.invalidate('daily_rate');
+    expect(full.getSnapshot().records?.[0]?.data.daily_rate).toBe(155);
+    full.dispose();
+  });
+
+  it('passes located GraphQL errors through to the source decoder', async () => {
+    const partial = {
+      data: {
+        getAllRooms: {
+          __typename: 'RoomResult',
+          success: true,
+          errors: null,
+          rooms: null,
+        },
+      },
+      errors: [{ message: 'Unavailable', path: ['getAllRooms', 'rooms'] }],
+    };
+    send.and.callFake(async () => new Response(JSON.stringify(partial)));
+    const result = await hotelTransport(
+      'http://localhost/graphql',
+      'token',
+    )(rooms.bind({}, { source: 'hotel-api', scope: 'test' }).prepare());
+    expect(result).toEqual(partial);
+  });
+
+  it('rejects malformed business envelopes', async () => {
+    send.and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: { getAllRooms: { __typename: 'RoomResult', rooms: [room] } },
+          }),
+        ),
+    );
+    await expectAsync(
+      hotelTransport(
+        'http://localhost/graphql',
+        'token',
+      )(rooms.bind({}, { source: 'hotel-api', scope: 'test' }).prepare()),
+    ).toBeRejectedWithError('Invalid hotel result envelope.');
+  });
+
+  it('rejects anonymous setup and synchronously gates changed credentials', async () => {
+    const catalog = TestBed.inject(RoomCatalog);
+    const full = catalog.client.watch(rooms.bind({}, catalog.binding()));
+    await full.ensure();
+    token.set(null);
+    expect(() => catalog.binding()).toThrowError(
+      'Hotel session changed. Sign in again.',
+    );
+    TestBed.tick();
+    await expectAsync(full.ensure()).toBeRejected();
+    TestBed.resetTestingModule();
+    TestBed.configureTestingModule({
+      providers: [
+        RoomCatalog,
+        { provide: AuthService, useValue: { sessionToken: token } },
+      ],
+    });
+    expect(() => TestBed.inject(RoomCatalog)).toThrowError(
+      'Sign in before loading rooms.',
+    );
+  });
+});
