@@ -0,0 +1,28 @@
+import { readFile, writeFile, mkdir } from 'node:fs/promises';
+import { generateSchemaModule } from '@tandrove/graphql/codegen';
+import { format } from 'prettier';
+
+const schema = await readFile(
+  new URL(
+    '../../backend/src/main/resources/graphql/schema.graphqls',
+    import.meta.url,
+  ),
+  'utf8',
+);
+const destination = new URL(
+  '../src/app/tandrove/generated/hotel.ts',
+  import.meta.url,
+);
+const output = await format(
+  generateSchemaModule(schema, {
+    identities: { Room: ['id'], Reservation: ['id'] },
+  }),
+  { parser: 'typescript', singleQuote: true },
+);
+if (process.argv.includes('--check')) {
+  if ((await readFile(destination, 'utf8')) !== output)
+    throw new Error('Generated hotel schema is stale.');
+} else {
+  await mkdir(new URL('.', destination), { recursive: true });
+  await writeFile(destination, output);
+}
