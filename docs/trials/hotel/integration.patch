+import { TestBed } from '@angular/core/testing';
+import { provideRouter } from '@angular/router';
+import { provideStore, Store } from '@ngrx/store';
+import { Actions } from '@ngrx/effects';
+import { Subject } from 'rxjs';
+import { AuthService } from '../core/services/auth.service';
+import { reservationReducer } from '../store/reservation/reservation.reducer';
+import { NewReservationComponent } from '../screens/reservations/new/new-reservation.component';
+
+describe('Booking room availability', () => {
+  beforeEach(() => {
+    TestBed.configureTestingModule({
+      imports: [NewReservationComponent],
+      providers: [
+        provideRouter([]),
+        provideStore({ reservation: reservationReducer }),
+        { provide: Actions, useValue: new Actions(new Subject()) },
+        {
+          provide: AuthService,
+          useValue: { sessionToken: () => 'trial-token' },
+        },
+      ],
+    });
+  });
+  afterEach(() => TestBed.resetTestingModule());
+
+  it('labels missing data as unavailable and prevents a booking command', async () => {
+    spyOn(window, 'fetch').and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: true,
+                errors: null,
+                rooms: [
+                  {
+                    __typename: 'Room',
+                    id: 'room_1',
+                    num_beds: 2,
+                    cleaning_fee: 20,
+                  },
+                ],
+              },
+            },
+          }),
+        ),
+    );
+    const fixture = TestBed.createComponent(NewReservationComponent);
+    const component = fixture.componentInstance;
+    component.formData = {
+      room_id: 'room_1',
+      checkin_date: '2027-06-01',
+      checkout_date: '2027-06-03',
+    };
+    fixture.detectChanges();
+    await component.roomQuery.ensure().catch(() => undefined);
+    fixture.detectChanges();
+    const text = fixture.nativeElement.textContent as string;
+    expect(text).toContain('Smoking policy unavailable');
+    expect(text).toContain('Selected room rate is unavailable');
+    expect(text).not.toContain('Non-smoking');
+    expect(
+      fixture.nativeElement.querySelector('button[type="submit"]').disabled,
+    ).toBeTrue();
+    const dispatch = spyOn(TestBed.inject(Store), 'dispatch');
+    component.onSubmit();
+    expect(dispatch).not.toHaveBeenCalled();
+    fixture.destroy();
+  });
+
+  it('shows membership drift until an explicit full catalog reload', async () => {
+    const room = {
+      __typename: 'Room',
+      id: 'room_1',
+      num_beds: 2,
+      allow_smoking: false,
+      daily_rate: 140,
+      cleaning_fee: 20,
+    };
+    let records: (typeof room)[] | null = [room];
+    spyOn(window, 'fetch').and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: true,
+                errors: null,
+                rooms: records,
+              },
+            },
+          }),
+        ),
+    );
+    const fixture = TestBed.createComponent(NewReservationComponent);
+    fixture.detectChanges();
+    await fixture.componentInstance.roomQuery.ensure();
+    records = [room, { ...room, id: 'room_2' }];
+    await fixture.componentInstance.refreshRates();
+    fixture.detectChanges();
+    expect(fixture.nativeElement.textContent).toContain(
+      'The room list may have changed',
+    );
+    expect(
+      fixture.nativeElement.querySelectorAll('#roomId option').length,
+    ).toBe(2);
+    await fixture.componentInstance.reloadRooms();
+    fixture.detectChanges();
+    expect(fixture.nativeElement.textContent).not.toContain(
+      'The room list may have changed',
+    );
+    expect(
+      fixture.nativeElement.querySelectorAll('#roomId option').length,
+    ).toBe(3);
+    fixture.componentInstance.formData = {
+      room_id: 'room_1',
+      checkin_date: '2027-07-01',
+      checkout_date: '2027-07-03',
+    };
+    records = [];
+    await fixture.componentInstance.reloadRooms();
+    fixture.detectChanges();
+    expect(fixture.componentInstance.formData.room_id).toBe('room_1');
+    expect(
+      fixture.nativeElement.querySelector('button[type="submit"]').disabled,
+    ).toBeTrue();
+    const dispatch = spyOn(TestBed.inject(Store), 'dispatch');
+    fixture.componentInstance.onSubmit();
+    expect(dispatch).not.toHaveBeenCalled();
+    records = null;
+    await fixture.componentInstance.reloadRooms();
+    fixture.detectChanges();
+    expect(fixture.nativeElement.textContent).toContain(
+      'The room catalog is unavailable.',
+    );
+    fixture.destroy();
+  });
+});
