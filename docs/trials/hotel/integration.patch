+// Generated from the GraphQL schema. Do not edit.
+import {
+  createSchema,
+  type FieldType,
+  type ObjectRef,
+} from '@tandrove/graphql';
+export type Inputs = {
+  ReservationInput: {
+    readonly room_id: string;
+    readonly checkin_date: string;
+    readonly checkout_date: string;
+  };
+};
+export type GeneratedTypes = {
+  Mutation: {
+    readonly createReservation: FieldType<
+      ObjectRef<'ReservationResult'>,
+      { readonly input: Inputs['ReservationInput'] }
+    >;
+    readonly deleteReservation: FieldType<
+      ObjectRef<'ReservationResult'>,
+      { readonly reservationId: number }
+    >;
+  };
+  Query: {
+    readonly getAllReservations: FieldType<ObjectRef<'ReservationResult'>, {}>;
+    readonly getAllRooms: FieldType<ObjectRef<'RoomResult'>, {}>;
+    readonly getReservation: FieldType<
+      ObjectRef<'ReservationResult'>,
+      { readonly id: string }
+    >;
+  };
+  Reservation: {
+    readonly id: FieldType<string, {}>;
+    readonly room_id: FieldType<string, {}>;
+    readonly checkin_date: FieldType<string, {}>;
+    readonly checkout_date: FieldType<string, {}>;
+    readonly total_charge: FieldType<number, {}>;
+  };
+  ReservationResult: {
+    readonly success: FieldType<boolean, {}>;
+    readonly errors: FieldType<readonly (string | null)[] | null, {}>;
+    readonly reservations: FieldType<
+      readonly (ObjectRef<'Reservation'> | null)[] | null,
+      {}
+    >;
+  };
+  Room: {
+    readonly id: FieldType<string, {}>;
+    readonly num_beds: FieldType<number, {}>;
+    readonly allow_smoking: FieldType<boolean, {}>;
+    readonly daily_rate: FieldType<number, {}>;
+    readonly cleaning_fee: FieldType<number, {}>;
+  };
+  RoomResult: {
+    readonly success: FieldType<boolean, {}>;
+    readonly errors: FieldType<readonly (string | null)[] | null, {}>;
+    readonly rooms: FieldType<readonly (ObjectRef<'Room'> | null)[] | null, {}>;
+  };
+};
+export const schema = createSchema<GeneratedTypes>(
+  'type Query {\n  getAllReservations: ReservationResult!\n  getAllRooms: RoomResult!\n  getReservation(id: ID!): ReservationResult!\n}\n\ntype Mutation {\n  createReservation(input: ReservationInput!): ReservationResult!\n  deleteReservation(reservationId: Int!): ReservationResult!\n}\n\ntype Reservation {\n  id: ID!\n  room_id: String!\n  checkin_date: String!\n  checkout_date: String!\n  total_charge: Float!\n}\n\ntype Room {\n  id: String!\n  num_beds: Int!\n  allow_smoking: Boolean!\n  daily_rate: Float!\n  cleaning_fee: Float!\n}\n\ninput ReservationInput {\n  room_id: String!\n  checkin_date: String!\n  checkout_date: String!\n}\n\ntype ReservationResult {\n  success: Boolean!\n  errors: [String]\n  reservations: [Reservation]\n}\n\ntype RoomResult {\n  success: Boolean!\n  errors: [String]\n  rooms: [Room]\n}',
+  { identities: { Room: ['id'], Reservation: ['id'] } },
+);
