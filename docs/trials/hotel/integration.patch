@@ -0,0 +1,48 @@
+import { DestroyRef, Injectable, effect, inject } from '@angular/core';
+import { createGraphQLClient } from '@tandrove/graphql';
+import { schema } from './generated/hotel';
+import { AuthService } from '../core/services/auth.service';
+import { hotelTransport } from './hotel-transport';
+
+export const rooms = schema.field('getAllRooms').field('rooms').select({
+  id: true,
+  num_beds: true,
+  allow_smoking: true,
+  daily_rate: true,
+  cleaning_fee: true,
+});
+export const roomRates = rooms.select({ id: true, daily_rate: true });
+
+/** One client per booking component; child views own independent handles. */
+@Injectable()
+export class RoomCatalog {
+  private readonly auth = inject(AuthService);
+  private readonly token = this.auth.sessionToken();
+  readonly client = createGraphQLClient({
+    transport: hotelTransport(
+      new URL('/graphql', location.origin).href,
+      this.requireToken(),
+    ),
+    retry: { retries: 1, initialDelayMs: 100, maxDelayMs: 100 },
+    requestPolicy: {
+      requestTimeoutMs: 2000,
+      retentionMs: 500,
+      freshness: { staleTimeMs: 30000, revalidate: 'on-demand' },
+    },
+  });
+  constructor() {
+    effect(() => {
+      if (this.auth.sessionToken() !== this.token) this.client.dispose();
+    });
+    inject(DestroyRef).onDestroy(() => this.client.dispose());
+  }
+  binding() {
+    if (this.auth.sessionToken() !== this.token)
+      throw new Error('Hotel session changed. Sign in again.');
+    return { source: 'hotel-api', scope: 'booking-session' } as const;
+  }
+  private requireToken(): string {
+    if (!this.token) throw new Error('Sign in before loading rooms.');
+    return this.token;
+  }
+}
