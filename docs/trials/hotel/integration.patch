+import { Component, computed, inject, input } from '@angular/core';
+import { CurrencyPipe } from '@angular/common';
+import { injectStateQuery } from '@tandrove/angular';
+import { RoomCatalog, roomRates } from './room-catalog';
+
+@Component({
+  selector: 'app-room-rate',
+  standalone: true,
+  imports: [CurrencyPipe],
+  template: `
+    <p data-testid="room-rate">
+      @if (!roomId()) {
+        Select a room to see its rate.
+      } @else if (rate() === undefined) {
+        Selected room rate is unavailable.
+      } @else {
+        Selected room rate: {{ rate() | currency }} per night.
+      }
+    </p>
+    @if (rateIssue()) {
+      <p role="status">{{ rateIssue() }} Displayed rates may be out of date.</p>
+    }
+    <small>Room charges are confirmed by the server when you book.</small>
+  `,
+})
+export class RoomRateComponent {
+  readonly roomId = input.required<string>();
+  private readonly catalog = inject(RoomCatalog);
+  readonly query = injectStateQuery(
+    () => roomRates.bind({}, this.catalog.binding()),
+    (definition) => this.catalog.client.watch(definition),
+  );
+  readonly rate = computed(() => {
+    const state = this.query.state();
+    return state.status === 'active'
+      ? state.snapshot.records?.find(
+          (record) => record.data.id === this.roomId(),
+        )?.data.daily_rate
+      : undefined;
+  });
+  readonly rateIssue = computed(() => {
+    const state = this.query.state();
+    if (state.status !== 'active')
+      return state.status === 'error' ? 'Rate lookup failed.' : '';
+    return (
+      state.snapshot.error ||
+      state.snapshot.resourceError ||
+      state.snapshot.records
+        ?.find((record) => record.data.id === this.roomId())
+        ?.fields.find((field) => field.error)?.error ||
+      (state.snapshot.stale ? 'Rates need refresh.' : '')
+    );
+  });
+}
