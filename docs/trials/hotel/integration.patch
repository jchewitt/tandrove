@@ -0,0 +1,59 @@
+import { Kind, print, visit } from 'graphql';
+import { httpTransport, type GraphQLTransport } from '@tandrove/graphql';
+
+function object(value: unknown): value is Record<string, unknown> {
+  return value !== null && typeof value === 'object' && !Array.isArray(value);
+}
+
+/** The hotel's in-band result envelope is application policy, outside the cache. */
+export function hotelTransport(
+  endpoint: string,
+  token: string,
+): GraphQLTransport {
+  const send = httpTransport({
+    endpoint,
+    headers: () => ({ Authorization: `Bearer ${token}` }),
+  });
+  return async (operation, context) => {
+    if (operation.responsePath[0] !== 'getAllRooms')
+      throw new Error('Unsupported hotel read.');
+    const document = visit(operation.document, {
+      Field(node) {
+        if (node.name.value !== 'getAllRooms' || !node.selectionSet)
+          return undefined;
+        return {
+          ...node,
+          selectionSet: {
+            ...node.selectionSet,
+            selections: [
+              ...node.selectionSet.selections,
+              ...['success', 'errors'].map((value) => ({
+                kind: Kind.FIELD as const,
+                name: { kind: Kind.NAME as const, value },
+              })),
+            ],
+          },
+        };
+      },
+    });
+    const response = await send(
+      { ...operation, document, query: print(document) },
+      context,
+    );
+    // Leave standard GraphQL execution errors to Tandrove's partial-result decoder.
+    if (!object(response) || !object(response['data'])) return response;
+    const result = response['data']['getAllRooms'];
+    if (result === null) return response;
+    if (!object(result) || typeof result['success'] !== 'boolean')
+      throw new Error('Invalid hotel result envelope.');
+    if (!result['success']) {
+      const errors = result['errors'];
+      throw new Error(
+        Array.isArray(errors) && typeof errors[0] === 'string'
+          ? errors[0]
+          : 'Unable to load rooms.',
+      );
+    }
+    return response;
+  };
+}
