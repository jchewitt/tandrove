+// Defense in depth: canceled transports must not be the only ownership guard.
+export function reservationReducer(
+  state: ReservationState | undefined,
+  action: Action,
+): ReservationState {
+  const current = state ?? initialState;
+  if (action.type === ReservationActions.sessionChanged.type) {
+    return {
+      ...initialState,
+      sessionEpoch: (
+        action as ReturnType<typeof ReservationActions.sessionChanged>
+      ).epoch,
+    };
+  }
+  if ('epoch' in action && action.epoch !== current.sessionEpoch)
+    return current;
+  return reduceReservation(current, action);
