@@ -0,0 +1,164 @@
+package com.acme.hotel.auth;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.asyncDispatch;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.options;
+import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.post;
+import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.status;
+
+import com.acme.hotel.model.Room;
+import com.acme.hotel.repository.ReservationRepository;
+import com.acme.hotel.repository.RoomRepository;
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import java.time.LocalDate;
+import java.util.Map;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.test.autoconfigure.web.servlet.AutoConfigureMockMvc;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.http.MediaType;
+import org.springframework.test.context.ActiveProfiles;
+import org.springframework.test.web.servlet.MockMvc;
+import org.springframework.test.web.servlet.MvcResult;
+
+@SpringBootTest
+@AutoConfigureMockMvc
+@ActiveProfiles({"test", "trial-accounts"})
+class TrialAccountsHttpTest {
+  @Autowired private MockMvc mvc;
+  @Autowired private ObjectMapper json;
+  @Autowired private ReservationRepository reservations;
+  @Autowired private RoomRepository rooms;
+
+  @BeforeEach
+  void seed() {
+    reservations.deleteAll();
+    rooms.save(new Room("trial_room_a", 2, false, 100, 20));
+    rooms.save(new Room("trial_room_b", 2, false, 200, 30));
+  }
+
+  String login(String account) throws Exception {
+    MvcResult result =
+        mvc.perform(
+                post("/development/token")
+                    .param("grant_type", "password")
+                    .param("username", account)
+                    .param("password", "example-user"))
+            .andExpect(status().isOk())
+            .andReturn();
+    return json.readTree(result.getResponse().getContentAsString()).get("access_token").asText();
+  }
+
+  JsonNode graphql(String token, String query) throws Exception {
+    MvcResult result =
+        mvc.perform(
+                post("/graphql")
+                    .header("Authorization", "Bearer " + token)
+                    .contentType(MediaType.APPLICATION_JSON)
+                    .content(json.writeValueAsString(Map.of("query", query))))
+            .andReturn();
+    if (result.getRequest().isAsyncStarted())
+      result = mvc.perform(asyncDispatch(result)).andReturn();
+    assertThat(result.getResponse().getStatus()).isEqualTo(200);
+    JsonNode response = json.readTree(result.getResponse().getContentAsString());
+    assertThat(response.has("errors")).isFalse();
+    return response.get("data");
+  }
+
+  String create(String room) {
+    return "mutation { createReservation(input: {room_id: \""
+        + room
+        + "\", checkin_date: \""
+        + LocalDate.now().plusDays(30)
+        + "\", checkout_date: \""
+        + LocalDate.now().plusDays(32)
+        + "\"}) { success errors reservations { id room_id } } }";
+  }
+
+  @Test
+  void verifiedPrincipalsOwnWritesAndCannotReadOrDeleteAnotherAccountsReservation()
+      throws Exception {
+    String a = login("example-user");
+    String b = login("trial-user-b");
+    JsonNode createdA = graphql(a, create("trial_room_a")).get("createReservation");
+    assertThat(createdA.get("success").asBoolean()).isTrue();
+    String idA = createdA.get("reservations").get(0).get("id").asText();
+    JsonNode overlap = graphql(b, create("trial_room_a")).get("createReservation");
+    assertThat(overlap.get("success").asBoolean()).isFalse();
+    assertThat(overlap.get("errors").get(0).asText()).contains("overlap");
+    assertThat(
+            graphql(b, "{ getAllReservations { success reservations { id } } }")
+                .get("getAllReservations")
+                .get("reservations")
+                .size())
+        .isZero();
+    assertThat(
+            graphql(b, "{ getReservation(id: \"" + idA + "\") { success errors } }")
+                .get("getReservation")
+                .get("success")
+                .asBoolean())
+        .isFalse();
+    assertThat(
+            graphql(
+                    b,
+                    "mutation { deleteReservation(reservationId: " + idA + ") { success errors } }")
+                .get("deleteReservation")
+                .get("success")
+                .asBoolean())
+        .isFalse();
+    JsonNode createdB = graphql(b, create("trial_room_b")).get("createReservation");
+    assertThat(createdB.get("reservations").size()).isEqualTo(1);
+    assertThat(createdB.get("reservations").get(0).get("room_id").asText())
+        .isEqualTo("trial_room_b");
+    assertThat(reservations.findById(Long.parseLong(idA)).orElseThrow().getOwnerAccount())
+        .isEqualTo("example-user");
+    assertThat(
+            graphql(a, "{ getAllReservations { reservations { id } } }")
+                .get("getAllReservations")
+                .get("reservations")
+                .size())
+        .isEqualTo(1);
+    assertThat(
+            graphql(
+                    a,
+                    "mutation { deleteReservation(reservationId: "
+                        + idA
+                        + ") { success reservations { id } } }")
+                .get("deleteReservation")
+                .get("reservations")
+                .size())
+        .isZero();
+    assertThat(reservations.findByOwnerAccountOrderByIdAsc("trial-user-b")).hasSize(1);
+  }
+
+  @Test
+  void graphqlRejectsAnonymousAndInvalidBearerRequestsWhilePreflightRemainsAllowed()
+      throws Exception {
+    String query = json.writeValueAsString(Map.of("query", "{ getAllRooms { success } }"));
+    mvc.perform(post("/graphql").contentType(MediaType.APPLICATION_JSON).content(query))
+        .andExpect(status().isForbidden());
+    mvc.perform(
+            post("/graphql")
+                .header("Authorization", "Bearer invalid")
+                .contentType(MediaType.APPLICATION_JSON)
+                .content(query))
+        .andExpect(status().isForbidden());
+    mvc.perform(
+            options("/graphql")
+                .header("Origin", "http://localhost:3000")
+                .header("Access-Control-Request-Method", "POST"))
+        .andExpect(status().isOk());
+  }
+
+  @Test
+  void secondAccountStillRequiresTheCorrectDevelopmentPassword() throws Exception {
+    mvc.perform(
+            post("/development/token")
+                .param("grant_type", "password")
+                .param("username", "trial-user-b")
+                .param("password", "wrong"))
+        .andExpect(status().isUnauthorized());
+  }
+}
