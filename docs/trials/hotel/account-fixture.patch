@@ -0,0 +1,36 @@
+package com.acme.hotel.auth;
+
+import org.springframework.beans.factory.annotation.Value;
+import org.springframework.security.authentication.AnonymousAuthenticationToken;
+import org.springframework.security.core.Authentication;
+import org.springframework.security.core.context.SecurityContextHolder;
+import org.springframework.stereotype.Component;
+
+/** Opt-in acceptance fixture. Authority always comes from the verified principal. */
+@Component
+public class TrialAccounts {
+  private final boolean enabled;
+
+  public TrialAccounts(@Value("${app.trial-accounts.enabled:false}") boolean enabled) {
+    this.enabled = enabled;
+  }
+
+  public boolean acceptsSecondAccount(String username) {
+    return enabled && "trial-user-b".equals(username);
+  }
+
+  public boolean acceptsPrincipal(String username) {
+    return "example-user".equals(username) || acceptsSecondAccount(username);
+  }
+
+  public String currentOwner() {
+    if (!enabled) return null;
+    Authentication authentication = SecurityContextHolder.getContext().getAuthentication();
+    if (authentication == null
+        || !authentication.isAuthenticated()
+        || authentication instanceof AnonymousAuthenticationToken) {
+      throw new IllegalStateException("Authentication is required");
+    }
+    return authentication.getName();
+  }
+}
