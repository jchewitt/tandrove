@@ -0,0 +1,227 @@
+import { ComponentFixture, TestBed } from '@angular/core/testing';
+import { signal } from '@angular/core';
+import { By } from '@angular/platform-browser';
+import { provideRouter, Router } from '@angular/router';
+import { provideStore } from '@ngrx/store';
+import { Actions } from '@ngrx/effects';
+import { BehaviorSubject, Subject, of } from 'rxjs';
+import type { CancellationSignal, MonotonicScheduler } from '@tandrove/core';
+import { AppComponent } from '../app.component';
+import { routes } from '../app.routes';
+import { SessionShellComponent } from '../core/session-shell.component';
+import { AuthService, HotelSession } from '../core/services/auth.service';
+import { reservationReducer } from '../store/reservation/reservation.reducer';
+import { NewReservationComponent } from '../screens/reservations/new/new-reservation.component';
+import { ROOM_CATALOG_CLOCK, RoomCatalog, rooms } from './room-catalog';
+
+class TrialClock implements MonotonicScheduler {
+  private time = 0;
+  readonly waits = new Set<{ at: number; finish: () => void }>();
+  now = () => this.time;
+  wait(ms: number, signal: CancellationSignal): Promise<void> {
+    return new Promise((resolve, reject) => {
+      if (signal.aborted) {
+        reject(signal.reason);
+        return;
+      }
+      const entry = {
+        at: this.time + ms,
+        finish: () => {
+          stop();
+          this.waits.delete(entry);
+          resolve();
+        },
+      };
+      const stop = signal.subscribe(() => {
+        this.waits.delete(entry);
+        reject(signal.reason);
+      });
+      this.waits.add(entry);
+    });
+  }
+  advanceTo(time: number): void {
+    if (time < this.time) throw new Error('Clock cannot go backwards');
+    this.time = time;
+    for (const entry of [...this.waits]) if (entry.at <= time) entry.finish();
+  }
+}
+
+describe('Session-owned catalog with route-owned booking queries', () => {
+  let fixture: ComponentFixture<AppComponent>;
+  let router: Router;
+  let clock: TrialClock;
+  let epochs: BehaviorSubject<number>;
+  const current = signal<HotelSession | null>(null);
+  let send: jasmine.Spy;
+  beforeEach(async () => {
+    clock = new TrialClock();
+    epochs = new BehaviorSubject(0);
+    current.set({ epoch: 0, account: 'example-user', token: 'same-token' });
+    TestBed.configureTestingModule({
+      imports: [AppComponent],
+      providers: [
+        provideRouter(routes),
+        provideStore({ reservation: reservationReducer }),
+        { provide: Actions, useValue: new Actions(new Subject()) },
+        { provide: ROOM_CATALOG_CLOCK, useValue: clock },
+        {
+          provide: AuthService,
+          useValue: {
+            session: current,
+            sessionToken: () => current()?.token ?? null,
+            epoch: () => epochs.value,
+            epochChanges: epochs,
+            login: () => of({ access_token: 'same-token' }),
+          },
+        },
+      ],
+    });
+    send = spyOn(window, 'fetch').and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: true,
+                errors: null,
+                rooms: [
+                  {
+                    __typename: 'Room',
+                    id: 'room_1',
+                    num_beds: 2,
+                    allow_smoking: false,
+                    daily_rate: 155,
+                    cleaning_fee: 99,
+                  },
+                ],
+              },
+            },
+          }),
+        ),
+    );
+    fixture = TestBed.createComponent(AppComponent);
+    fixture.detectChanges();
+    router = TestBed.inject(Router);
+    await router.navigateByUrl('/home');
+    fixture.detectChanges();
+  });
+  afterEach(() => {
+    fixture.destroy();
+    TestBed.resetTestingModule();
+    expect(clock.waits.size).toBe(0);
+  });
+  const catalog = () =>
+    fixture.debugElement
+      .query(By.directive(SessionShellComponent))
+      .injector.get(RoomCatalog);
+  const home = async () => {
+    await router.navigateByUrl('/home');
+    fixture.detectChanges();
+  };
+  const book = async () => {
+    await router.navigateByUrl('/reservations/new');
+    fixture.detectChanges();
+    const component = fixture.debugElement.query(
+      By.directive(NewReservationComponent),
+    ).componentInstance as NewReservationComponent;
+    await component.roomQuery.ensure();
+    fixture.detectChanges();
+    return component;
+  };
+  const flush = async () => {
+    for (let i = 0; i < 30; i++) await Promise.resolve();
+    fixture.detectChanges();
+  };
+
+  it('retains one session client across real routes without retaining a form draft', async () => {
+    const first = await book();
+    const owner = catalog();
+    first.formData = {
+      room_id: 'room_1',
+      checkin_date: '2027-11-01',
+      checkout_date: '2027-11-03',
+    };
+    await home();
+    expect(first.roomQuery.state().status).toBe('disposed');
+    clock.advanceTo(1000);
+    const second = await book();
+    expect(catalog()).toBe(owner);
+    expect(second).not.toBe(first);
+    expect(second.formData).toEqual({
+      room_id: '',
+      checkin_date: '',
+      checkout_date: '',
+    });
+    expect(second.roomRecords().length).toBe(1);
+    expect(send.calls.count()).toBe(1);
+  });
+
+  it('cancels old expiry on return and starts a new window on the next final departure', async () => {
+    await book();
+    await home(); // expiry at 5000
+    clock.advanceTo(4000);
+    await book();
+    clock.advanceTo(6000);
+    await flush(); // old expiry cannot evict active state
+    expect(send.calls.count()).toBe(1);
+    await home(); // new expiry at 11000
+    clock.advanceTo(10000);
+    await book();
+    expect(send.calls.count()).toBe(1);
+    await home(); // new expiry at 15000
+    clock.advanceTo(15000);
+    await flush();
+    await book();
+    expect(send.calls.count()).toBe(2);
+  });
+
+  it('revalidates original field age after a short absence spanning freshness expiry', async () => {
+    await book();
+    clock.advanceTo(29000);
+    await home();
+    clock.advanceTo(31000);
+    await book();
+    expect(send.calls.count()).toBe(2);
+  });
+
+  it('stops route polling while keeping the session client and retained data alive', async () => {
+    const first = await book();
+    const owner = catalog();
+    first.togglePolling();
+    clock.advanceTo(500);
+    await flush();
+    expect(send.calls.count()).toBe(2);
+    await home();
+    clock.advanceTo(2000);
+    await flush();
+    expect(send.calls.count()).toBe(2);
+    expect(catalog()).toBe(owner);
+    const second = await book();
+    expect(second.polling).toBeFalse();
+    clock.advanceTo(4000);
+    await flush();
+    expect(send.calls.count()).toBe(2);
+  });
+
+  it('synchronously destroys retained state on logout and isolates an identical-token new epoch', async () => {
+    await book();
+    const old = catalog();
+    await home();
+    expect(clock.waits.size).toBeGreaterThan(0);
+    current.set(null);
+    epochs.next(1);
+    expect(clock.waits.size).toBe(0);
+    expect(() =>
+      old.client.watch(
+        rooms.bind({}, { source: 'hotel-api', scope: 'booking-session-0' }),
+      ),
+    ).toThrowError('Client is disposed.');
+    fixture.detectChanges();
+    current.set({ epoch: 1, account: 'example-user', token: 'same-token' });
+    fixture.detectChanges();
+    await book();
+    expect(catalog()).not.toBe(old);
+    expect(send.calls.count()).toBe(2);
+  });
+});
