@@ -0,0 +1,85 @@
+import { TestBed } from '@angular/core/testing';
+import { provideHttpClient } from '@angular/common/http';
+import {
+  HttpTestingController,
+  provideHttpClientTesting,
+} from '@angular/common/http/testing';
+import { Actions } from '@ngrx/effects';
+import { provideStore, Action } from '@ngrx/store';
+import { Subject } from 'rxjs';
+import { ReservationEffects } from './reservation.effects';
+import { reservationReducer } from './reservation.reducer';
+import * as actions from './reservation.actions';
+
+describe('Reservation create correlation', () => {
+  let input: Subject<Action>;
+  let http: HttpTestingController;
+  let effects: ReservationEffects;
+  beforeEach(() => {
+    input = new Subject();
+    TestBed.configureTestingModule({
+      providers: [
+        provideHttpClient(),
+        provideHttpClientTesting(),
+        provideStore({ reservation: reservationReducer }),
+        ReservationEffects,
+        { provide: Actions, useValue: new Actions(input) },
+      ],
+    });
+    http = TestBed.inject(HttpTestingController);
+    effects = TestBed.inject(ReservationEffects);
+  });
+  afterEach(() => {
+    http.verify();
+    TestBed.resetTestingModule();
+  });
+
+  for (const scenario of ['success', 'business failure', 'HTTP failure']) {
+    it(`echoes the local command ID on ${scenario} without sending it as GraphQL input`, () => {
+      const received: Action[] = [];
+      const subscription = effects.createReservation$.subscribe((result) =>
+        received.push(result),
+      );
+      input.next(
+        actions.createReservation({
+          commandId: 'request-one',
+          room_id: 'room_1',
+          checkin_date: '2027-08-01',
+          checkout_date: '2027-08-03',
+        }),
+      );
+      const request = http.expectOne('/graphql');
+      expect(request.request.body.variables.input).toEqual({
+        room_id: 'room_1',
+        checkin_date: '2027-08-01',
+        checkout_date: '2027-08-03',
+      });
+      if (scenario === 'HTTP failure')
+        request.flush('Unavailable', {
+          status: 503,
+          statusText: 'Unavailable',
+        });
+      else
+        request.flush({
+          data: {
+            createReservation: {
+              success: scenario === 'success',
+              errors: scenario === 'success' ? null : ['Overlap'],
+              reservations: [],
+            },
+          },
+        });
+      expect(received.length).toBe(1);
+      expect((received[0] as { commandId?: string }).commandId).toBe(
+        'request-one',
+      );
+      expect(received[0].type).toBe(
+        scenario === 'success'
+          ? actions.createReservationSuccess.type
+          : actions.createReservationFailure.type,
+      );
+      http.expectNone('/graphql');
+      subscription.unsubscribe();
+    });
+  }
+});
