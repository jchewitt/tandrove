diff --git a/frontend/src/app/tandrove/booking-save.spec.ts b/frontend/src/app/tandrove/booking-save.spec.ts
new file mode 100644
index 0000000..d03446c
--- /dev/null
+++ b/frontend/src/app/tandrove/booking-save.spec.ts
@@ -0,0 +1,165 @@
+import { ComponentFixture, TestBed } from '@angular/core/testing';
+import { provideRouter, Router } from '@angular/router';
+import { provideStore, Store, Action } from '@ngrx/store';
+import { Actions } from '@ngrx/effects';
+import { Subject } from 'rxjs';
+import { AuthService } from '../core/services/auth.service';
+import { reservationReducer } from '../store/reservation/reservation.reducer';
+import * as actions from '../store/reservation/reservation.actions';
+import { NewReservationComponent } from '../screens/reservations/new/new-reservation.component';
+
+describe('Booking save ownership', () => {
+  let outcomes: Subject<Action>;
+  let fixture: ComponentFixture<NewReservationComponent>;
+  let component: NewReservationComponent;
+  let dispatch: jasmine.Spy;
+  let navigate: jasmine.Spy;
+  beforeEach(async () => {
+    outcomes = new Subject<Action>();
+    TestBed.configureTestingModule({
+      imports: [NewReservationComponent],
+      providers: [
+        provideRouter([]),
+        provideStore({ reservation: reservationReducer }),
+        { provide: Actions, useValue: new Actions(outcomes) },
+        {
+          provide: AuthService,
+          useValue: { sessionToken: () => 'trial-token' },
+        },
+      ],
+    });
+    spyOn(window, 'fetch').and.callFake(
+      async () =>
+        new Response(
+          JSON.stringify({
+            data: {
+              getAllRooms: {
+                __typename: 'RoomResult',
+                success: true,
+                errors: null,
+                rooms: [
+                  {
+                    __typename: 'Room',
+                    id: 'room_1',
+                    num_beds: 2,
+                    allow_smoking: false,
+                    daily_rate: 140,
+                    cleaning_fee: 20,
+                  },
+                ],
+              },
+            },
+          }),
+        ),
+    );
+    fixture = TestBed.createComponent(NewReservationComponent);
+    component = fixture.componentInstance;
+    fixture.detectChanges();
+    await component.roomQuery.ensure();
+    component.formData = {
+      room_id: 'room_1',
+      checkin_date: '2027-08-01',
+      checkout_date: '2027-08-03',
+    };
+    fixture.detectChanges();
+    await Promise.resolve();
+    dispatch = spyOn(TestBed.inject(Store), 'dispatch');
+    navigate = spyOn(TestBed.inject(Router), 'navigate').and.resolveTo(true);
+  });
+  afterEach(() => {
+    fixture.destroy();
+    TestBed.resetTestingModule();
+  });
+  const success = (commandId: string) =>
+    actions.createReservationSuccess({ commandId, reservations: [] });
+
+  it('observes a matching success dispatched synchronously and settles once', () => {
+    dispatch.and.callFake((action) => outcomes.next(success(action.commandId)));
+    component.onSubmit();
+    expect(navigate).toHaveBeenCalledOnceWith(['/home']);
+    expect(component.pendingCommandId).toBeUndefined();
+    outcomes.next(success(dispatch.calls.mostRecent().args[0].commandId));
+    expect(navigate).toHaveBeenCalledTimes(1);
+  });
+
+  it('ignores unrelated results and blocks a second submit while pending', () => {
+    component.onSubmit();
+    const id = component.pendingCommandId!;
+    outcomes.next(success('another-editor'));
+    outcomes.next(
+      actions.createReservationFailure({
+        commandId: 'another-editor',
+        error: 'Other failure',
+      }),
+    );
+    component.onSubmit();
+    expect(dispatch).toHaveBeenCalledTimes(1);
+    expect(component.pendingCommandId).toBe(id);
+    expect(navigate).not.toHaveBeenCalled();
+    outcomes.next(success(id));
+    expect(navigate).toHaveBeenCalledTimes(1);
+  });
+
+  it('ends a failed attempt, preserves the draft and correlates a new-ID retry', () => {
+    component.onSubmit();
+    const first = component.pendingCommandId!;
+    const draft = { ...component.formData };
+    outcomes.next(
+      actions.createReservationFailure({ commandId: first, error: 'Overlap' }),
+    );
+    expect(component.pendingCommandId).toBeUndefined();
+    expect(component.formData).toEqual(draft);
+    outcomes.next(success(first));
+    expect(navigate).not.toHaveBeenCalled();
+    component.onSubmit();
+    const second = component.pendingCommandId!;
+    expect(second).not.toBe(first);
+    outcomes.next(success(first));
+    expect(component.pendingCommandId).toBe(second);
+    outcomes.next(success(second));
+    expect(navigate).toHaveBeenCalledTimes(1);
+  });
+
+  it('releases the listener when its component is destroyed', () => {
+    component.onSubmit();
+    const id = component.pendingCommandId!;
+    fixture.destroy();
+    outcomes.next(success(id));
+    expect(navigate).not.toHaveBeenCalled();
+    expect(component.pendingCommandId).toBeUndefined();
+  });
+
+  it('keeps submitted values separate and preserves later user edits on success', async () => {
+    component.onSubmit();
+    const submitted = dispatch.calls.mostRecent().args[0];
+    const input: HTMLInputElement =
+      fixture.nativeElement.querySelector('#checkoutDate');
+    input.value = '2027-08-04';
+    input.dispatchEvent(new Event('input'));
+    fixture.detectChanges();
+    await Promise.resolve();
+    expect(submitted.checkout_date).toBe('2027-08-03');
+    expect(component.formData.checkout_date).toBe('2027-08-04');
+    outcomes.next(success(submitted.commandId));
+    expect(component.formData.checkout_date).toBe('2027-08-04');
+    expect(navigate).not.toHaveBeenCalled();
+    expect(component.saveNotice).toContain('unsent booking draft');
+  });
+
+  it('preserves edit intent even when the user changes a value and changes it back', async () => {
+    component.onSubmit();
+    const id = component.pendingCommandId!;
+    const input: HTMLInputElement =
+      fixture.nativeElement.querySelector('#checkoutDate');
+    for (const value of ['2027-08-04', '2027-08-03']) {
+      input.value = value;
+      input.dispatchEvent(new Event('input'));
+      fixture.detectChanges();
+      await Promise.resolve();
+    }
+    outcomes.next(success(id));
+    expect(component.formData.checkout_date).toBe('2027-08-03');
+    expect(navigate).not.toHaveBeenCalled();
+    expect(component.saveNotice).toContain('unsent booking draft');
+  });
+});
