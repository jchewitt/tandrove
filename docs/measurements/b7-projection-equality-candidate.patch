 const reusableInputs = new WeakMap<object, string | null>();
 
+/** Internal construction only; never registers caller-owned objects as trusted. */
+export function assembleInputObject(
+  populate: (put: (key: string, value: InputValue) => void) => void,
+): InputObject {
+  const result: Record<string, InputValue> = Object.create(null) as Record<
+    string,
+    InputValue
+  >;
+  let reusable = true;
+  let previous: string | undefined;
+  populate((key, value) => {
+    result[key] = value;
+    // Preserve insertion order. Aliases in noncanonical order simply retain
+    // the ordinary validating/copying path, as do arrays and their ancestors.
+    reusable &&=
+      typeof key === 'string' &&
+      (previous === undefined || previous <= key) &&
+      (value === null ||
+        typeof value === 'string' ||
+        typeof value === 'boolean' ||
+        (typeof value === 'number' &&
+          Number.isFinite(value) &&
+          !Object.is(value, -0)) ||
+        (typeof value === 'object' && reusableInputs.has(value)));
+    previous = key;
+  });
+  Object.freeze(result);
+  if (reusable) reusableInputs.set(result, null);
+  return result;
+}
