index 0000000..ce0d918
--- /dev/null
+++ b/packages/core/test/projection-input.test.mjs
@@ -0,0 +1,140 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { StateStore, canonicalInput, snapshotInput } from '../dist/index.js';
+import * as publicApi from '../dist/index.js';
+
+const field = (name, responseName = name, children = []) => ({
+  name,
+  responseName,
+  arguments: {},
+  children,
+});
+const write = (name, value) => ({
+  kind: 'write',
+  record: { id: 1 },
+  path: [{ name, arguments: {} }],
+  value,
+});
+function setup(selection, changes) {
+  const store = new StateStore();
+  const view = store.watch('test', selection);
+  store.commit('test', [
+    { kind: 'membership', records: [{ id: 1 }] },
+    ...changes,
+  ]);
+  return { store, view };
+}
+
+test('projected data preserves alias insertion order and canonical value equality', () => {
+  for (const aliases of [
+    ['a', 'b'],
+    ['z', 'a'],
+    ['10', '2'],
+    ['__proto__', 'constructor'],
+  ]) {
+    const { store, view } = setup(
+      [field('first', aliases[0]), field('second', aliases[1])],
+      [write('first', { z: 1, a: 2 }), write('second', 'unchanged')],
+    );
+    const before = view.getSnapshot();
+    const expected = Object.assign(Object.create(null), {
+      [aliases[0]]: { a: 2, z: 1 },
+      [aliases[1]]: 'unchanged',
+    });
+    assert.deepEqual(
+      Object.keys(before.records[0].data),
+      Object.keys(expected),
+    );
+    assert.equal(
+      canonicalInput(before.records[0].data),
+      canonicalInput(expected),
+    );
+    assert.equal(
+      canonicalInput(snapshotInput(before.records[0].data)),
+      canonicalInput(expected),
+    );
+    let calls = 0;
+    view.subscribe(() => calls++);
+    store.commit('test', [write('first', { a: 2, z: 1 })]);
+    assert.equal(view.getSnapshot(), before);
+    assert.equal(calls, 0);
+    store.commit('test', [write('first', { a: 3, z: 1 })]);
+    assert.equal(calls, 1);
+    assert.equal(view.getSnapshot().records[0].data[aliases[1]], 'unchanged');
+    store.dispose();
+  }
+});
+
+test('array-bearing projections retain later iteration and serialization hooks', () => {
+  const { store, view } = setup(
+    [field('items')],
+    [write('items', { nested: ['held'] })],
+  );
+  const data = view.getSnapshot().records[0].data;
+  const iterator = Object.getOwnPropertyDescriptor(
+    Array.prototype,
+    Symbol.iterator,
+  );
+  const toJSON = Object.getOwnPropertyDescriptor(Array.prototype, 'toJSON');
+  let copied, encoded;
+  try {
+    Object.defineProperty(Array.prototype, Symbol.iterator, {
+      ...iterator,
+      value: function* () {
+        if (this === data.items.nested) yield 'changed';
+        else yield* iterator.value.call(this);
+      },
+    });
+    copied = snapshotInput(data);
+    encoded = canonicalInput(data);
+  } finally {
+    Object.defineProperty(Array.prototype, Symbol.iterator, iterator);
+  }
+  assert.equal(copied.items.nested[0], 'changed');
+  assert.equal(encoded, '{"items":{"nested":["changed"]}}');
+  try {
+    Object.defineProperty(Array.prototype, 'toJSON', {
+      configurable: true,
+      value() {
+        return this.length === 1 && this[0] === 'held' ? 'encoded' : this;
+      },
+    });
+    encoded = canonicalInput(data);
+  } finally {
+    if (toJSON) Object.defineProperty(Array.prototype, 'toJSON', toJSON);
+    else delete Array.prototype.toJSON;
+  }
+  assert.equal(encoded, '{"items":{"nested":"encoded"}}');
+  assert.equal(canonicalInput(data), '{"items":{"nested":["held"]}}');
+  store.dispose();
+});
+
+test('projected immutable children do not bless caller-owned siblings or wrappers', () => {
+  assert.equal('assembleInputObject' in publicApi, false);
+  const { store, view } = setup(
+    [field('payload')],
+    [write('payload', { a: 1 })],
+  );
+  const data = view.getSnapshot().records[0].data;
+  const mutable = { value: 2 };
+  const caller = Object.freeze({ data, mutable });
+  const copied = snapshotInput(caller);
+  mutable.value = 3;
+  assert.equal(copied.mutable.value, 2);
+  assert.equal(snapshotInput(caller).mutable.value, 3);
+  assert.throws(
+    () => canonicalInput({ data, invalid: Infinity }),
+    /finite JSON/,
+  );
+  assert.throws(
+    () =>
+      snapshotInput({
+        data,
+        get invalid() {
+          return 1;
+        },
+      }),
+    /accessors/,
+  );
+  store.dispose();
+});
